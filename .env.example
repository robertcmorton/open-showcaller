# Postgres connection. Leave unset in local dev to use the embedded PGlite database (./.pglite).
DATABASE_URL=postgres://showcaller:showcaller@localhost:5432/showcaller

# Sync server: one port serves the HTTP API, the show channel (ws /), and doc sync (ws /doc).
PORT=8787

# Web build-time endpoints (public URLs of the sync server)
NEXT_PUBLIC_SYNC_HTTP_URL=http://localhost:8787
NEXT_PUBLIC_SYNC_WS_URL=ws://localhost:8787
NEXT_PUBLIC_DOC_WS_URL=ws://localhost:8787/doc
